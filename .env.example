# --- Default: Local Ollama (free, low-RAM Qwen) ---
LLM_PROVIDER=openai
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5:3b
# Low-RAM fallback (2GB): qwen2.5:0.5b (396MB, already pulled in CI)
# 8GB+ RAM alternative: qwen2.5:7b or llama3.1:8b also work via same API

# --- OpenRouter (one key: free + paid models). Or paste the key in the dashboard instead. ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=auto            # auto = best model for this key (paid if it has credit, else best free)

# Optional: Override with Anthropic (paid) — uncomment to use Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-5-sonnet-20241022

# Optional: Override with hosted OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4-turbo

# Optional overrides
# LLM_MODEL=claude-3-5-sonnet-20240620
# ACTION_AUTO_THRESHOLD=0.85
# ACTION_ANALYST_THRESHOLD=0.50
VITE_API_URL=http://localhost:8000

# Groq / Gemini / xAI work the same way: LLM_PROVIDER=groq|gemini|xai with GROQ_API_KEY / GEMINI_API_KEY / XAI_API_KEY
# Skip the .env/Ollama model entirely (CI, benchmarks): CYBERGRAPHRAG_OFFLINE=1
