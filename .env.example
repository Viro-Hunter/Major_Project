LLM_PROVIDER=anthropic
LLM_API_KEY=your_anthropic_api_key_here

# Optional: Override with OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4-turbo

# Optional: any OpenAI-compatible endpoint (Ollama, LM Studio, Groq, ...)
# LLM_PROVIDER=openai
# OPENAI_API_BASE=http://localhost:11434/v1   # Ollama
# OPENAI_API_KEY=ollama                        # any placeholder for local endpoints
# OPENAI_MODEL=llama3.1:8b